<% content_for :title, "Talep oluştur" %>

<h1>Destek talebi oluştur</h1>

<%= form_with model: @ticket, url: requests_path, class: "form panel" do |f| %>
  <% if @ticket.errors.any? %>
    <div class="flash flash-alert">
      <strong>Talep kaydedilemedi:</strong>
      <ul><% @ticket.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>

  <div class="row">
    <label>Adınız <%= f.text_field :requester_name, required: true %></label>
    <label>E-posta <%= f.email_field :requester_email, required: true %></label>
  </div>
  <label>Konu <%= f.text_field :subject, required: true %></label>
  <label>Öncelik <%= f.select :priority, priority_options %></label>
  <label>Açıklama <%= f.text_area :description, rows: 6, required: true %></label>
  <%= f.submit "Talebi gönder", class: "button" %>
<% end %>
